# === Database (Postgres) ===
DATABASE_URL="postgres://postgres:postgres@localhost:5432/tiktok"

# === Better-Auth ===
# Generate a secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET="change-me-in-production"
BETTER_AUTH_URL="http://localhost:4000"
# Comma-separated origins allowed to send credentialed requests (frontend URLs).
TRUSTED_ORIGINS="http://localhost:5173"

# === Object storage (MinIO / any S3-compatible) ===
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="uploads"
# Public base URL objects are served from. For a public MinIO bucket this is
# `${S3_ENDPOINT}/${S3_BUCKET}`. In prod point it at your storage domain/CDN.
S3_PUBLIC_URL="http://localhost:9000/uploads"
